# allow dir + .gitkeep placeholders (override earlier ignores)
/data/**
!data/**/.gitkeep

/datamart/**                 # ignore EVERYTHING under datamart
!/datamart/**/.gitkeep       # …but allow .gitkeep placeholders so dirs can exist


